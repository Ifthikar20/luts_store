# ---------------------------------------------------------------------------
# LUTs Store Backend (BFF) - Environment configuration
# Copy this file to ".env" and fill in values. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# Django secret key. A clearly-insecure dev fallback is used if unset, but you
# MUST set a strong random value in any non-dev environment.
SECRET_KEY=

# Debug mode. Defaults to False. Set to True ONLY for local development.
DEBUG=False

# Comma-separated list of allowed hosts (e.g. "api.example.com,localhost").
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of allowed CORS origins (the Next.js frontend).
# CORS is NEVER opened to all origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated list of CSRF trusted origins (scheme + host).
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Optional Postgres connection string. If empty, SQLite is used.
# Example: postgres://user:pass@localhost:5432/luts
DATABASE_URL=

# ---------------------------------------------------------------------------
# Security header toggles. Keep these False in local http dev; enable in prod.
# In production (HTTPS) set SECURE_SSL_REDIRECT=True, SECURE_HSTS_SECONDS=31536000,
# and both *_COOKIE_SECURE=True — the deploy (aws/04-app.sh) does this for you in
# domain mode. With the cookies Secure, the session/CSRF cookies also switch to
# the hardened __Host- prefix automatically.
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# Session lifetime in seconds (default 14 days). Sessions refresh on activity.
SESSION_COOKIE_AGE=1209600

# ---------------------------------------------------------------------------
# Shopify credentials. ALL server-side only. NEVER expose these to clients.
# If SHOPIFY_STOREFRONT_TOKEN is empty, the backend runs in MOCK_MODE and
# serves the in-repo fixture catalog with no Shopify connection.
# ---------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=example-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2024-10

# Admin API (order reads). Server-side only.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2024-10

# Webhook shared secret used to verify X-Shopify-Hmac-Sha256 signatures.
SHOPIFY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Payments — Stripe Checkout (self-contained; no Shopify store required).
# Set STRIPE_SECRET_KEY to take real payments: /api/checkout returns a hosted
# Stripe Checkout URL, and Stripe calls /api/webhooks/stripe on completion to
# create the order, issue downloads and send the receipt email. Get keys at
# dashboard.stripe.com; create the webhook endpoint there and copy its signing
# secret into STRIPE_WEBHOOK_SECRET. Use test keys (sk_test_… / whsec_…) first.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Redis — shared cache for rate-limit counters. STRONGLY recommended in
# production: without it, throttles count per-process and the effective limit
# multiplies by the number of gunicorn workers/replicas. Blank = in-memory
# (fine for single-process dev). The docker-compose stack sets this for you.
# ---------------------------------------------------------------------------
REDIS_URL=

# ---------------------------------------------------------------------------
# Shopify Customer Accounts (OAuth 2.0 / OpenID Connect, PKCE) — OPTIONAL login.
# Powers the hosted-login account/library portal (like thelookslab.com): scope
# "openid email customer-account-api:full", response_type=code.
#
# LEAVE THESE BLANK FOR LOCAL DEV: with no CLIENT_ID + SHOP_ID the portal uses a
# clearly-gated MOCK login path (a demo email field) so it runs with NO Shopify
# credentials. Setting BOTH CLIENT_ID and SHOP_ID switches to the REAL OAuth
# flow. See LIVE_SETUP.md "Shopify Customer Accounts (login)".
#
# Login is OPTIONAL — guest checkout and login-free downloads are UNAFFECTED.
# ---------------------------------------------------------------------------
# The customer-account / headless app client id from the Shopify admin.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# Optional client secret. Only for a CONFIDENTIAL client; public clients use
# PKCE alone and leave this blank.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
# The NUMERIC shop id used in the shopify.com customer-account URLs
# (https://shopify.com/authentication/<SHOP_ID>/oauth/authorize).
SHOPIFY_CUSTOMER_ACCOUNT_SHOP_ID=
# Customer Account API version (default 2024-10).
SHOPIFY_CUSTOMER_ACCOUNT_API_VERSION=2024-10
# OAuth redirect/callback URI. Must EXACTLY match an allowed redirect URI in the
# Shopify customer-account client config. Default is the local API origin; in
# production use https://api.yourdomain.com/api/auth/shopify/callback.
SHOPIFY_CUSTOMER_ACCOUNT_REDIRECT_URI=http://localhost:8000/api/auth/shopify/callback

# ---------------------------------------------------------------------------
# Signed download tokens.
# ---------------------------------------------------------------------------
# Lifetime of a download token in seconds (default 24h).
DOWNLOAD_TOKEN_MAX_AGE=86400

# Base for signed S3 URLs in real mode (mock mode ignores this). Legacy; the
# presigned-URL flow below derives the URL from boto3, not this base.
DOWNLOAD_S3_BASE_URL=https://example-bucket.s3.amazonaws.com

# ---------------------------------------------------------------------------
# Secure file delivery via PRIVATE S3 (presigned URLs).
# When AWS_S3_BUCKET is set, the backend serves downloads as short-lived,
# SigV4-signed presigned S3 URLs (302 redirect). Leave it blank to stay in the
# mock path (streams a generated .cube placeholder so the demo still works).
# Credentials: set AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY for an IAM user, or
# leave them blank on EC2/ECS to use the instance role (boto3 default chain).
#
# The bucket MUST be private (S3 Block Public Access ON). Use a least-privilege
# IAM user/role with s3:GetObject scoped to the key prefix only. See
# DEPLOYMENT.md and EC2_SETUP.md.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=
# Optional custom endpoint for S3-compatible stores (MinIO, Cloudflare R2,
# Wasabi). Leave blank for AWS S3.
AWS_S3_ENDPOINT_URL=
# Prefix under which LUT files live. Object keys are derived server-side as
# "<S3_KEY_PREFIX>/<handle>.zip" (never from the client/token).
S3_KEY_PREFIX=luts
# Lifetime (seconds) of a presigned download URL. Short so a leaked URL expires
# fast. Distinct from DOWNLOAD_TOKEN_MAX_AGE (the signed grant-link lifetime).
DOWNLOAD_URL_TTL=60

# --- Preview media delivery (CDN) + transcode ------------------------------
# PUBLIC preview images/videos (NOT the paid LUT files) are served via a
# CloudFront CDN for edge caching + cheap egress when CDN_BASE_URL is set;
# blank falls back to same-origin presigned /api/media redirects. Created by
# aws/06-cdn.sh, e.g. https://d1234abcd.cloudfront.net
CDN_BASE_URL=
# AWS Elemental MediaConvert transcodes uploaded preview clips into adaptive
# HLS (1080/720/480 + poster). Set the service-role ARN (from aws/02-iam.sh) to
# enable; blank stores clips as-is and serves them progressively (no HLS).
MEDIACONVERT_ROLE_ARN=
# Optional: pin the account MediaConvert endpoint (else auto-discovered) and a
# named queue (else the account default on-demand queue).
MEDIACONVERT_ENDPOINT=
MEDIACONVERT_QUEUE_ARN=

# ---------------------------------------------------------------------------
# Frontend / public site URL. Used to build customer-facing links inside
# emails (download library, support). SITE_URL is accepted as an alias.
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
# SITE_URL=http://localhost:3000

# Public origin of THIS backend API. Used to make the signed download links in
# emails absolute/clickable (e.g. https://api.thelookslab.com).
API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Email delivery.
# In development the console backend prints emails to stdout (no SMTP needed).
# For real delivery set EMAIL_BACKEND to the SMTP backend and fill the rest.
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False

# The From address on outgoing customer emails.
DEFAULT_FROM_EMAIL=The Looks Lab <hello@thelookslab.com>

# Support address surfaced in customer emails.
SUPPORT_EMAIL=support@thelookslab.com

# ---------------------------------------------------------------------------
# Social sign-in (required to buy). ALL auth is owned by the Django backend.
# Leave blank for the dev "mock:<email>" sign-in (local/CI).
#
# Google: create a "Web application" OAuth client at console.cloud.google.com
# and register GOOGLE_REDIRECT_URI as an authorized redirect URI. With BOTH
# CLIENT_ID and CLIENT_SECRET set, the backend runs the full authorization-code
# flow: the SPA just navigates to /api/auth/google/login, the user signs in on
# Google's screen, and lands back on the site with an httpOnly Django session.
# Apple: the "Services ID" identifier (developer.apple.com).
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an authorized redirect URI on the Google OAuth client. In
# production use https://api.yourdomain.com/api/auth/google/callback.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
APPLE_CLIENT_ID=

# --- Bot protection: Google reCAPTCHA v3 -----------------------------------
# Guards sign-in/sign-up and review submission against bots. Get a v3 key pair
# at google.com/recaptcha. The SECRET goes here; the public SITE key goes in the
# frontend (NEXT_PUBLIC_RECAPTCHA_SITE_KEY). Blank = checks skipped (dev/CI).
RECAPTCHA_SECRET_KEY=
# Reject scores below this (0.0 bot … 1.0 human). 0.5 is Google's default.
RECAPTCHA_MIN_SCORE=0.5

# --- Field-level encryption at rest ----------------------------------------
# Encrypts sensitive free-text (review titles/bodies) in the database. A
# urlsafe-base64 32-byte Fernet key; blank derives one from SECRET_KEY (works
# out of the box). Set a dedicated key in production so rotating SECRET_KEY
# doesn't make existing ciphertext undecryptable. Generate with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Trustpilot Automatic Feedback Service: the unique BCC address that triggers
# a VERIFIED review invitation for every order-confirmation email. Blank = off.
TRUSTPILOT_AFS_BCC=

FIELD_ENCRYPTION_KEY=

# Error monitoring (optional). Set to your Sentry DSN to capture exceptions.
SENTRY_DSN=

# Optional comma-separated IP allowlist for /admin/ (blank = no restriction).
ADMIN_IP_ALLOWLIST=
