# Public base URL of the Django BFF. Only NEXT_PUBLIC_ variables are exposed to
# the browser — never put secrets (API keys, tokens) in this file.
# Copy this file to .env.local and adjust as needed.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Public canonical site URL — used for SEO metadataBase, sitemap.xml and
# robots.txt absolute URLs. Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
