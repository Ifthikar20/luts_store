# Public base URL of the Django BFF. Only NEXT_PUBLIC_ variables are exposed to
# the browser — never put secrets (API keys, tokens) in this file.
# Copy this file to .env.local and adjust as needed.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Public canonical site URL — used for SEO metadataBase, sitemap.xml and
# robots.txt absolute URLs. Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Apple sign-in client id (public by design). When set, the Apple button
# redirects to Apple's hosted sign-in; when blank, a dev email sign-in is used
# (and the backend accepts the matching mock token). Must match the backend's
# APPLE_CLIENT_ID.
#
# NOTE: Google needs NO frontend config — the Django backend owns the whole
# Google OAuth flow (set GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET in the
# backend's .env). The button just navigates to /api/auth/google/login.
NEXT_PUBLIC_APPLE_CLIENT_ID=
