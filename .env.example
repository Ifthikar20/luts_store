# ---------------------------------------------------------------------------
# Root-level env for docker-compose (the prod-like local stack).
# Copy to ".env" — docker compose reads it automatically. NEVER commit a real
# .env. App-level config lives in backend/.env (see backend/.env.example).
# ---------------------------------------------------------------------------

# Postgres credentials for the `db` service (and the backend's DATABASE_URL,
# which compose assembles from these).
POSTGRES_DB=luts
POSTGRES_USER=luts
POSTGRES_PASSWORD=change-me-in-prod

# Hosts Django will serve. Include `backend` so in-cluster calls are accepted.
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Public build-time config baked into the frontend image. These are exposed to
# the browser by design — never put secrets here. Point at the backend's
# host-published port.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
