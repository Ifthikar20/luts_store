# Root-level ignores (each app also has its own .gitignore)

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Secrets — never commit real env files
.env
.env.local
*.env.local
backend/.env
frontend/.env.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.sqlite3

# Node
node_modules/
.next/
out/
npm-debug.log*
yarn-error.log*

# Logs
*.log
