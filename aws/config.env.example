# aws/config.env — settings shared by every aws/*.sh script.
# Copy to aws/config.env and fill in. This file is git-ignored.

# Region everything is created in.
AWS_REGION=us-east-1

# Globally-unique S3 bucket name for the private product files.
BUCKET_NAME=luts-store-files-CHANGEME

# EC2
INSTANCE_TYPE=t3.small
KEY_NAME=luts-store               # EC2 key-pair name. 03 creates it (saves aws/<name>.pem),
                                  # OR set it to a pair you already have (e.g. fynda-deploy).
# Reuse a private key you already downloaded instead of letting 03 create one.
# Point KEY_FILE at it; 03 then never creates or overwrites a key pair, and
# 04/05 ssh with this exact file. (Still git-ignored — never commit a .pem.)
#KEY_NAME=fynda-deploy
#KEY_FILE=~/Downloads/LUTS.shop/luts_store/fynda-deploy.pem
SSH_CIDR=0.0.0.0/0                # tighten to <your-ip>/32 if you have a stable IP

# Deploy on the raw Elastic IP over plain HTTP (no domain, no TLS) for now.
# Set USE_IP=1 to go live on http://<EIP> before you own a domain; once you have
# one, set USE_IP=0, fill in the domains below, and re-run 04 to switch to HTTPS.
USE_IP=0

# Your domains (only used when USE_IP=0; set DNS A records to the EIP from 03).
DOMAIN=luts.example.com           # storefront
API_DOMAIN=api.luts.example.com   # backend API

# Repo the instance clones (use an https deploy token URL if private).
REPO_URL=https://github.com/Ifthikar20/luts_store.git

# Names (fine as-is)
ROLE_NAME=luts-store-ec2-role
SG_NAME=luts-store-sg
