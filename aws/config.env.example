# aws/config.env — settings shared by every aws/*.sh script.
# Copy to aws/config.env and fill in. This file is git-ignored.

# Region everything is created in.
AWS_REGION=us-east-1

# Globally-unique S3 bucket name for the private product files.
BUCKET_NAME=luts-store-files-CHANGEME

# EC2
INSTANCE_TYPE=t3.small
KEY_NAME=luts-store               # key pair name; 03 creates it (saves aws/<name>.pem)
SSH_CIDR=0.0.0.0/0                # tighten to <your-ip>/32 if you have a stable IP

# Your domains (set DNS A records to the Elastic IP printed by 03).
DOMAIN=luts.example.com           # storefront
API_DOMAIN=api.luts.example.com   # backend API

# Repo the instance clones (use an https deploy token URL if private).
REPO_URL=https://github.com/Ifthikar20/luts_store.git

# Names (fine as-is)
ROLE_NAME=luts-store-ec2-role
SG_NAME=luts-store-sg
