# aws/production-secrets.env — the keys only you have. Pushed to the server's
# backend/.env by ./05-secrets.sh. Git-ignored; never commit the real file.

# Stripe (dashboard.stripe.com → Developers). Webhook endpoint:
#   https://<API_DOMAIN>/api/webhooks/stripe
#   events: checkout.session.completed, charge.refunded
STRIPE_SECRET_KEY=sk_test_CHANGEME
STRIPE_WEBHOOK_SECRET=whsec_CHANGEME

# SMTP for receipt/refund emails (any ESP: SES, Postmark, Resend, ...)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGEME
EMAIL_HOST_PASSWORD=CHANGEME
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Luts.shop <hello@example.com>

# Sign-in with Google — makes "Continue with Google" redirect to Google's real
# sign-in screen (without these it falls back to the demo "enter any email" form).
# Create a "Web application" OAuth client at console.cloud.google.com →
# APIs & Services → Credentials, then add this EXACT authorized redirect URI:
#   https://<API_DOMAIN>/api/auth/google/callback
# (The server sets GOOGLE_REDIRECT_URI to that automatically on deploy — you only
#  paste the client id/secret here.) Google does NOT allow raw IP addresses, so
# this needs a real domain + HTTPS (USE_IP=0). Leave both blank to keep the demo
# login; fill BOTH to switch Google on.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign-in with Apple (optional, not enabled yet — needs an extra frontend
# build-arg wired up first). APPLE_CLIENT_ID=

# Bot protection — Google reCAPTCHA v3 SECRET key (google.com/recaptcha). The
# matching public SITE key goes in aws/config.env (RECAPTCHA_SITE_KEY). Blank =
# bot checks disabled. Protects sign-in/sign-up and review submission.
RECAPTCHA_SECRET_KEY=

# Optional — live Shopify catalog instead of the in-repo one:
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOPIFY_STOREFRONT_TOKEN=
# SHOPIFY_WEBHOOK_SECRET=
