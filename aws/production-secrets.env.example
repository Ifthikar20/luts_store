# aws/production-secrets.env — the keys only you have. Pushed to the server's
# backend/.env by ./05-secrets.sh. Git-ignored; never commit the real file.

# Stripe (dashboard.stripe.com → Developers). Webhook endpoint:
#   https://<API_DOMAIN>/api/webhooks/stripe
#   events: checkout.session.completed, charge.refunded
STRIPE_SECRET_KEY=sk_test_CHANGEME
STRIPE_WEBHOOK_SECRET=whsec_CHANGEME

# SMTP for receipt/refund emails (any ESP: SES, Postmark, Resend, ...)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGEME
EMAIL_HOST_PASSWORD=CHANGEME
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Luts.shop <hello@example.com>

# Sign-in with Google (required to buy). Create a "Web application" OAuth client
# at console.cloud.google.com → APIs & Services → Credentials, and add this as an
# authorized redirect URI:  https://<API_DOMAIN>/api/auth/google/callback
# NOTE: Google does NOT allow raw IP addresses — this needs a real domain+HTTPS.
# Leave blank to keep the local "enter any email" demo login.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=

# Optional — live Shopify catalog instead of the in-repo one:
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOPIFY_STOREFRONT_TOKEN=
# SHOPIFY_WEBHOOK_SECRET=
